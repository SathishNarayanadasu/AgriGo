<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="240dp"
    android:height="240dp"
    android:viewportWidth="240"
    android:viewportHeight="240">
  
  <!-- Dirt Patch Base (Isometric Oval) -->
  <path
      android:pathData="M 120 180 C 180 180 220 150 220 120 C 220 90 180 60 120 60 C 60 60 20 90 20 120 C 20 150 60 180 120 180 Z">
    <aapt:attr name="android:fillColor">
      <gradient 
          android:startX="120" android:startY="60"
          android:endX="120" android:endY="180"
          android:type="linear">
        <item android:offset="0" android:color="#5C4033"/>
        <item android:offset="1" android:color="#3E2723"/>
      </gradient>
    </aapt:attr>
  </path>
  
  <!-- Dirt Texture Highlights -->
  <path
      android:pathData="M 80 100 C 100 90 140 90 160 100 C 150 110 90 110 80 100 Z"
      android:fillColor="#4E342E" />
  <path
      android:pathData="M 100 140 C 120 130 150 130 170 140 C 160 150 110 150 100 140 Z"
      android:fillColor="#4E342E" />

  <!-- Shovel Handle (Wood) -->
  <path
      android:pathData="M 50 30 L 70 20 L 130 110 L 110 120 Z">
    <aapt:attr name="android:fillColor">
      <gradient 
          android:startX="50" android:startY="30"
          android:endX="130" android:endY="120"
          android:type="linear">
        <item android:offset="0" android:color="#D7CCC8"/>
        <item android:offset="1" android:color="#8D6E63"/>
      </gradient>
    </aapt:attr>
  </path>
  
  <!-- Shovel Grip (Top) -->
  <path
      android:pathData="M 40 40 L 60 10 L 80 20 L 60 50 Z"
      android:fillColor="#5D4037" />
  <path
      android:pathData="M 30 25 L 50 5 L 60 10 L 40 30 Z"
      android:fillColor="#795548" />

  <!-- Shovel Blade (Metal) -->
  <path
      android:pathData="M 110 120 L 130 110 L 160 150 C 170 170 140 180 130 170 Z">
    <aapt:attr name="android:fillColor">
      <gradient 
          android:startX="110" android:startY="120"
          android:endX="150" android:endY="170"
          android:type="linear">
        <item android:offset="0" android:color="#B0BEC5"/>
        <item android:offset="1" android:color="#607D8B"/>
      </gradient>
    </aapt:attr>
  </path>
  
  <!-- Metal Highlight -->
  <path
      android:pathData="M 115 125 L 125 120 L 145 150 C 150 160 135 165 130 160 Z"
      android:fillColor="#CFD8DC" />

</vector>
